@@ -0,0 +1,31 @@
+import { csvCell } from './worksheet-csv.ts';
+
+export const reviewGroups = [
+  { title: '1. Repeatable context', fields: [
+    ['brand', 'Brand or product', 'The exact brand being reviewed'],
+    ['competitor', 'Close competitor', 'A relevant alternative, or not applicable'],
+    ['prompt', 'Exact prompt', 'Paste the question unchanged'],
+    ['context', 'Date, engine and setup', 'Date/time, engine/model, country/language, login, plan and search enabled or disabled. Record unknowns.'],
+  ] },
+  { title: '2. What the answer says', fields: [
+    ['evidence', 'Answer evidence', 'Paste the relevant answer excerpt and a run ID or evidence reference'],
+    ['attributes', 'Observed brand attributes', 'Audience, features, price positioning or other descriptions actually present'],
+    ['objection', 'Buying objection', 'What might discourage a buyer? Use not observed if absent.'],
+    ['verification', 'Fact check', 'What supports or contradicts the claim? Record evidence and unknowns.'],
+  ] },
+  { title: '3. Sources you can inspect', fields: [
+    ['sources', 'Cited URLs and source types', 'For each URL: own site, owned profile, independent source, competitor or unknown. Match it to the relevant claim where possible.'],
+    ['grounding', 'Observed grounding queries', 'Paste only platform-disclosed queries with their evidence reference, or write unavailable.'],
+  ] },
+  { title: '4. Choose a useful action', fields: [
+    ['action', 'Action and target page', 'What should change, where, and what evidence will support it?'],
+    ['owner', 'Owner and recheck date', 'Who will do it and when will you repeat the same prompt and setup?'],
+    ['check', 'Completion check', 'How will you verify the correction or service improvement separately from a later AI response?'],
+  ] },
+] as const;
+export const objectionTypes = ['Not reviewed', 'True limitation needing context', 'Outdated claim needing correction', 'Real service problem needing work', 'Unverified assertion needing investigation', 'No objection observed'] as const;
+export function brandReviewCsv(values: Record<string, string>): string {
+  const rows = [['Group', 'Field', 'Value'], ...reviewGroups.flatMap(group => group.fields.map(([key, label]) => [group.title, label, values[key] || 'Not recorded'])), ['4. Choose a useful action', 'Objection category', values.category || 'Not reviewed']];
+  rows.push(['Credit', 'Practitioner guidance', 'Ann Smarty: https://www.annsmarty.com/p/geoaeo-audit-and-ai-visibility-tracking']);
+  return '\uFEFF' + rows.map(row => row.map(csvCell).join(',')).join('\r\n');
+}
diff --git a/artifacts/geo-seo-tool/src/lib/brand-review.test.ts b/artifacts/geo-seo-tool/src/lib/brand-review.test.ts
new file mode 100644
index 0000000..8df6498
