+import { useState } from 'react';
+import { brandReviewCsv, objectionTypes, reviewGroups } from '@/lib/brand-review';
+
+export function BrandPerceptionReview() {
+  const [values, setValues] = useState<Record<string, string>>({});
+  const [downloaded, setDownloaded] = useState(false);
+  function update(key: string, value: string) {
+    setValues(current => ({ ...current, [key]: value }));
+    setDownloaded(false);
+  }
+  function download() {
+    const url = URL.createObjectURL(new Blob([brandReviewCsv(values)], { type: 'text/csv;charset=utf-8' }));
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = 'brand-perception-review.csv';
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
+    setDownloaded(true);
+  }
+  return <section id="brand-review" aria-labelledby="brand-review-heading" className="my-10 scroll-mt-8 rounded-xl border border-teal-200 bg-white p-5 text-slate-800 sm:p-7">
+    <h2 id="brand-review-heading" className="text-2xl font-bold">Review how AI describes your brand</h2>
+    <p className="mt-3 text-sm leading-6">Inspired by <a className="text-teal-800 underline" href="https://www.annsmarty.com/" target="_blank" rel="noopener noreferrer">Ann Smarty</a>’s approach to reviewing brand attributes, buying objections and cited sources. <a className="text-teal-800 underline" href="https://www.annsmarty.com/p/geoaeo-audit-and-ai-visibility-tracking" target="_blank" rel="noopener noreferrer">Read her original article</a>. This is practitioner guidance, not an endorsement or a confirmed ranking factor.</p>
+    <p className="mt-3 text-sm leading-6">Use one form per prompt and engine answer. These notes stay in this tab and are lost on reload or navigation. Download before leaving. Nothing entered here is saved to your account or sent to an AI provider.</p>
+    <details className="mt-5">
+      <summary className="cursor-pointer rounded-lg border border-teal-700 px-4 py-3 font-semibold text-teal-900 focus-visible:outline focus-visible:outline-2">Open manual brand review</summary>
+      <div className="mt-6 space-y-6">
+        {reviewGroups.map(group => <fieldset key={group.title} className="min-w-0 rounded-lg border border-slate-200 p-4">
+          <legend className="px-2 font-semibold">{group.title}</legend>
+          <div className="grid gap-4 sm:grid-cols-2">{group.fields.map(([key, label, hint]) => <label key={key} className="block min-w-0 text-sm font-medium" htmlFor={`brand-review-${key}`}>
+            {label}<textarea id={`brand-review-${key}`} value={values[key] || ''} onChange={event => update(key, event.target.value)} placeholder={hint} rows={3} className="mt-2 block w-full rounded-md border border-slate-400 bg-white p-3 text-slate-900 focus:outline focus:outline-2 focus:outline-teal-700" />
+          </label>)}</div>
+          {group.title.startsWith('4.') && <label className="mt-4 block text-sm font-medium" htmlFor="brand-review-category">Objection category<select id="brand-review-category" value={values.category || 'Not reviewed'} onChange={event => update('category', event.target.value)} className="mt-2 block w-full rounded-md border border-slate-400 bg-white p-3 text-slate-900">{objectionTypes.map(type => <option key={type}>{type}</option>)}</select></label>}
+        </fieldset>)}
+        <p className="text-sm leading-6">Cited sources are evidence to inspect, not proof of influence or truth. A small prompt sample is not a measure of overall reputation. Keep unavailable queries distinct from generated suggestions. Private browsing does not remove every source of personalization.</p>
+        <div className="flex flex-wrap gap-3"><button type="button" onClick={download} className="min-h-11 rounded-lg bg-teal-800 px-4 py-3 font-semibold text-white">Download brand review CSV</button><button type="button" onClick={() => { if (window.confirm('Clear this review? Download a copy first if you need to keep it.')) { setValues({}); setDownloaded(false); } }} className="min-h-11 rounded-lg border border-slate-400 px-4 py-3">Clear brand review</button></div>
+        <p role="status" className="text-sm">{downloaded ? 'Download created. Keep the CSV before leaving this page.' : 'Review is not saved. Export a copy to keep your notes.'}</p>
+      </div>
+    </details>
+  </section>;
+}
