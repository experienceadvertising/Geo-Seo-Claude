+++ b/artifacts/geo-seo-tool/src/lib/brand-review.test.ts
@@ -0,0 +1,18 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { brandReviewCsv } from './brand-review.ts';
+
+test('review export preserves multiline evidence and credit, and marks missing data', () => {
+  const csv = brandReviewCsv({ evidence: 'First line\nHe said "teams"', category: 'Outdated claim needing correction' });
+  assert.ok(csv.startsWith('\uFEFF'));
+  assert.ok(csv.includes('"First line\nHe said ""teams"""'));
+  assert.ok(csv.includes('Not recorded'));
+  assert.ok(csv.includes('Outdated claim needing correction'));
+  assert.ok(csv.includes('Ann Smarty: https://www.annsmarty.com/'));
+});
+test('review export neutralizes formula values in evidence and action fields', () => {
+  const csv = brandReviewCsv({ evidence: '=HYPERLINK("https://example.com")', action: ' \t+1+1', owner: '@SUM(1)' });
+  assert.ok(csv.includes('"\'=HYPERLINK'));
+  assert.ok(csv.includes('"\' \t+1+1"'));
+  assert.ok(csv.includes('"\'@SUM(1)"'));
+});
